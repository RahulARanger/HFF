#!/usr/bin/env bash
#PBS -N hff_high_freq
#PBS -q workq
#PBS -l select=1:ncpus=16:mem=64gb:ngpus=1
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

INPUT_PATH="${HFF_INPUT_PATH:-dataset/brats2019/splits/explore}"
MATLAB_BIN="${HFF_MATLAB:-matlab}"

usage() {
  echo "Usage: qsub -- scripts/submit_high_freq_gpu.pbs --path PATH [--toolbox-dir PATH]"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --path)
      [[ $# -ge 2 ]] || { echo "Error: --path requires a value" >&2; usage >&2; exit 1; }
      INPUT_PATH="$2"
      shift 2
      ;;
    --toolbox-dir)
      [[ $# -ge 2 ]] || { echo "Error: --toolbox-dir requires a value" >&2; usage >&2; exit 1; }
      HFF_NSCT_TOOLBOX="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ "$INPUT_PATH" != /* ]]; then
  INPUT_PATH="$REPO_ROOT/$INPUT_PATH"
fi
if [[ ! -d "$INPUT_PATH" ]]; then
  echo "Error: input path not found: $INPUT_PATH" >&2
  exit 1
fi
if ! command -v "$MATLAB_BIN" >/dev/null 2>&1; then
  echo "Error: MATLAB executable not found: $MATLAB_BIN" >&2
  exit 1
fi
if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "Error: CUDA_VISIBLE_DEVICES is not set. Set it to the allocated MIG UUID from nvidia-smi -L." >&2
  exit 1
fi

CONDA_ENV="${HFF_CONDA_ENV:-hffnet}"
if [[ -n "$CONDA_ENV" ]]; then
  CONDA_SH="${HFF_CONDA_SH:-}"
  if [[ -z "$CONDA_SH" && -n "${HFF_CONDA_BASE:-}" ]]; then
    CONDA_SH="$HFF_CONDA_BASE/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" ]] && command -v conda >/dev/null 2>&1; then
    CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" || ! -f "$CONDA_SH" ]]; then
    echo "Error: Conda is not initialized in PBS. Set HFF_CONDA_BASE or HFF_CONDA_SH." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$CONDA_SH"
  conda activate "$CONDA_ENV"
fi

export HFF_BASE_DIR="$INPUT_PATH"
export HFF_NSCT_TOOLBOX="${HFF_NSCT_TOOLBOX:-$REPO_ROOT/NSCT_BTS/nsct_toolbox}"

echo "[$(date)] Starting high-frequency generation on workq"
echo "Input: $HFF_BASE_DIR"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
"$MATLAB_BIN" -batch "run('$REPO_ROOT/NSCT_BTS/nsct_hf.m')"
echo "[$(date)] High-frequency generation complete"
