#!/usr/bin/env bash
#PBS -N hff_low_freq
#PBS -q cpuq
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

INPUT_PATH="${HFF_INPUT_PATH:-dataset/brats2019/splits/explore}"
PYTHON_BIN="${HFF_PYTHON:-python}"

usage() {
  echo "Usage: qsub -- scripts/submit_low_freq_cpu.pbs --path PATH"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --path)
      [[ $# -ge 2 ]] || { echo "Error: --path requires a value" >&2; usage >&2; exit 1; }
      INPUT_PATH="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ "$INPUT_PATH" != /* ]]; then
  INPUT_PATH="$REPO_ROOT/$INPUT_PATH"
fi
if [[ ! -d "$INPUT_PATH" ]]; then
  echo "Error: input path not found: $INPUT_PATH" >&2
  exit 1
fi

CONDA_ENV="${HFF_CONDA_ENV:-hffnet}"
if [[ -n "$CONDA_ENV" ]]; then
  CONDA_SH="${HFF_CONDA_SH:-}"
  if [[ -z "$CONDA_SH" && -n "${HFF_CONDA_BASE:-}" ]]; then
    CONDA_SH="$HFF_CONDA_BASE/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" ]] && command -v conda >/dev/null 2>&1; then
    CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" || ! -f "$CONDA_SH" ]]; then
    echo "Error: Conda is not initialized in PBS. Set HFF_CONDA_BASE or HFF_CONDA_SH." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$CONDA_SH"
  conda activate "$CONDA_ENV"
fi

echo "[$(date)] Starting low-frequency generation on CPU"
echo "Input: $INPUT_PATH"
"$PYTHON_BIN" scripts/generate_low_freq.py --path "$INPUT_PATH"
echo "[$(date)] Low-frequency generation complete"
