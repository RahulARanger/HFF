#!/usr/bin/env bash
#PBS -N hff_cross_train
#PBS -q workq
# Validation is streamed in bounded groups; 12 CPU cores are sufficient for
# the reduced DataLoader worker count and leave the 64 GB RAM allocation clear.
#PBS -l select=1:ncpus=12:mem=64gb:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

PYTHON_BIN="${HFF_PYTHON:-python}"
GPU_DEVICE="${HFF_GPU_DEVICE:-}"

usage() {
  cat <<'USAGE'
Usage:
  qsub -v HFF_GPU_DEVICE=<device> -- scripts/submit_train_gpu.pbs \
    [--gpu-device <device>] <cross_train.py options> -- <train.py options>

The device may be a physical GPU index (for example, 6) or a MIG UUID
(for example, MIG-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx). It is exposed to
the process through CUDA_VISIBLE_DEVICES, where it becomes logical cuda:0.

Examples:
  qsub -v HFF_GPU_DEVICE=6 -- scripts/submit_train_gpu.pbs \
    dataset/brats2019/splits/explore \
    --run-name explore_brats19 --epochs 1 -- \
    --dataset_name brats19 --class_type all

  qsub -- scripts/submit_train_gpu.pbs \
    --gpu-device MIG-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx \
    dataset/brats2019/splits/explore --run-name explore_brats19 -- \
    --dataset_name brats19 --class_type all
USAGE
}

# Parse only the PBS-wrapper option. All other arguments belong to
# cross_train.py, including the second `--` separator for train.py options.
TRAIN_ARGS=()
FORWARD_SEPARATOR_SEEN=0
while [[ $# -gt 0 ]]; do
  if [[ "$FORWARD_SEPARATOR_SEEN" -eq 1 ]]; then
    TRAIN_ARGS+=("$1")
    shift
    continue
  fi

  case "$1" in
    --)
      TRAIN_ARGS+=("$1")
      FORWARD_SEPARATOR_SEEN=1
      shift
      ;;
    --gpu-device|--gpu)
      [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; usage >&2; exit 1; }
      GPU_DEVICE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      TRAIN_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$GPU_DEVICE" ]]; then
  echo "Error: select one GPU or MIG device with --gpu-device or HFF_GPU_DEVICE." >&2
  usage >&2
  exit 1
fi

if [[ "$GPU_DEVICE" == *,* ]]; then
  echo "Error: only one GPU/MIG device is allowed; received: $GPU_DEVICE" >&2
  exit 1
fi

CONDA_ENV="${HFF_CONDA_ENV:-hffnet}"
if [[ -n "$CONDA_ENV" ]]; then
  CONDA_SH="${HFF_CONDA_SH:-}"
  if [[ -z "$CONDA_SH" && -n "${HFF_CONDA_BASE:-}" ]]; then
    CONDA_SH="$HFF_CONDA_BASE/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" ]] && command -v conda >/dev/null 2>&1; then
    CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" || ! -f "$CONDA_SH" ]]; then
    echo "Error: Conda is not initialized in PBS. Set HFF_CONDA_BASE or HFF_CONDA_SH." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$CONDA_SH"
  conda activate "$CONDA_ENV"
fi

echo "Initial CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-unset}"
echo "PBS_GPUFILE: ${PBS_GPUFILE:-unset}"
if [[ -n "${PBS_GPUFILE:-}" && -f "$PBS_GPUFILE" ]]; then
  echo "PBS allocated GPU resources:"
  cat "$PBS_GPUFILE"
fi

export CUDA_VISIBLE_DEVICES="$GPU_DEVICE"
export WANDB_MODE="${WANDB_MODE:-offline}"
export PYTHONNOUSERSITE="${PYTHONNOUSERSITE:-1}"

echo "[$(date)] Starting HFF-Net cross-validation training"
echo "PBS job ID: ${PBS_JOBID:-not set}"
echo "Repository: $REPO_ROOT"
echo "Selected device: $GPU_DEVICE"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "WANDB_MODE: $WANDB_MODE"

if [[ ${#TRAIN_ARGS[@]} -eq 0 ]]; then
  echo "Error: no cross_train.py arguments were supplied." >&2
  usage >&2
  exit 1
fi

"$PYTHON_BIN" cross_train.py "${TRAIN_ARGS[@]}"
echo "[$(date)] Cross-validation training complete"
