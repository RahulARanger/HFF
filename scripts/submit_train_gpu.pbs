#!/usr/bin/env bash
#PBS -N hff_train_et
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

TRAIN_LIST="${HFF_TRAIN_LIST:-dataset/brats2019/splits/explore/train.txt}"
VAL_LIST="${HFF_VAL_LIST:-dataset/brats2019/splits/explore/validation.txt}"
PYTHON_BIN="${HFF_PYTHON:-python}"
DATASET_NAME="brats19"
CLASS_TYPE="et"
NUM_EPOCHS=350
BATCH_SIZE=1

usage() {
  echo "Usage: qsub -- scripts/submit_train_gpu.pbs [options]"
  echo "  --train_list PATH   Training list"
  echo "  --val_list PATH     Validation list"
  echo "  --dataset_name NAME (default: $DATASET_NAME)"
  echo "  --class_type TYPE   (default: $CLASS_TYPE)"
  echo "  --num_epochs N      (default: $NUM_EPOCHS)"
  echo "  --batch_size N      (default: $BATCH_SIZE)"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --train_list)
      [[ $# -ge 2 ]] || { echo "Error: --train_list requires a value" >&2; usage >&2; exit 1; }
      TRAIN_LIST="$2"
      shift 2
      ;;
    --val_list)
      [[ $# -ge 2 ]] || { echo "Error: --val_list requires a value" >&2; usage >&2; exit 1; }
      VAL_LIST="$2"
      shift 2
      ;;
    --dataset_name)
      [[ $# -ge 2 ]] || { echo "Error: --dataset_name requires a value" >&2; usage >&2; exit 1; }
      DATASET_NAME="$2"
      shift 2
      ;;
    --class_type)
      [[ $# -ge 2 ]] || { echo "Error: --class_type requires a value" >&2; usage >&2; exit 1; }
      CLASS_TYPE="$2"
      shift 2
      ;;
    --num_epochs)
      [[ $# -ge 2 ]] || { echo "Error: --num_epochs requires a value" >&2; usage >&2; exit 1; }
      NUM_EPOCHS="$2"
      shift 2
      ;;
    --batch_size)
      [[ $# -ge 2 ]] || { echo "Error: --batch_size requires a value" >&2; usage >&2; exit 1; }
      BATCH_SIZE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

for LIST_PATH in "$TRAIN_LIST" "$VAL_LIST"; do
  if [[ "$LIST_PATH" != /* ]]; then
    LIST_PATH="$REPO_ROOT/$LIST_PATH"
  fi
  if [[ ! -f "$LIST_PATH" ]]; then
    echo "Error: list file not found: $LIST_PATH" >&2
    exit 1
  fi
done

if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "Error: CUDA_VISIBLE_DEVICES is not set. Set it to the allocated MIG UUID from nvidia-smi -L." >&2
  exit 1
fi

CONDA_ENV="${HFF_CONDA_ENV:-hffnet}"
if [[ -n "$CONDA_ENV" ]]; then
  CONDA_SH="${HFF_CONDA_SH:-}"
  if [[ -z "$CONDA_SH" && -n "${HFF_CONDA_BASE:-}" ]]; then
    CONDA_SH="$HFF_CONDA_BASE/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" ]] && command -v conda >/dev/null 2>&1; then
    CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
  fi
  if [[ -z "$CONDA_SH" || ! -f "$CONDA_SH" ]]; then
    echo "Error: Conda is not initialized in PBS. Set HFF_CONDA_BASE or HFF_CONDA_SH." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$CONDA_SH"
  conda activate "$CONDA_ENV"
fi

export WANDB_MODE=offline

echo "[$(date)] Starting HFF-Net ET training on workq"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
"$PYTHON_BIN" train.py \
  --train_list "$TRAIN_LIST" \
  --val_list "$VAL_LIST" \
  --dataset_name "$DATASET_NAME" \
  --class_type "$CLASS_TYPE" \
  --num_epochs "$NUM_EPOCHS" \
  --batch_size "$BATCH_SIZE"
echo "[$(date)] Training complete"
