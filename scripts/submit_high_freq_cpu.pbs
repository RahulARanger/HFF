#!/usr/bin/env bash
#PBS -N hff_high_freq_cpu
#PBS -q cpuq
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

REPO_ROOT="${PBS_O_WORKDIR:-/Data4/me_FA0498/Data_6/HFF}"
cd "$REPO_ROOT"

INPUT_PATH="${HFF_INPUT_PATH:-dataset/brats2019/splits/explore}"
MATLAB_BIN="${HFF_MATLAB:-matlab}"

if [[ "$INPUT_PATH" != /* ]]; then
  INPUT_PATH="$REPO_ROOT/$INPUT_PATH"
fi

if [[ ! -d "$INPUT_PATH" ]]; then
  echo "Error: input path not found: $INPUT_PATH" >&2
  exit 1
fi

if [[ "$MATLAB_BIN" == */* ]]; then
  if [[ ! -x "$MATLAB_BIN" ]]; then
    echo "Error: MATLAB executable not found or not executable: $MATLAB_BIN" >&2
    exit 1
  fi
elif ! command -v "$MATLAB_BIN" >/dev/null 2>&1; then
  echo "Error: MATLAB executable not found: $MATLAB_BIN" >&2
  exit 1
fi

export HFF_BASE_DIR="$INPUT_PATH"
export HFF_NSCT_TOOLBOX="${HFF_NSCT_TOOLBOX:-$REPO_ROOT/NSCT_BTS/nsct_toolbox}"

MATLAB_SCRIPT="$REPO_ROOT/NSCT_BTS/nsct_hf.m"

if [[ ! -f "$MATLAB_SCRIPT" ]]; then
  echo "Error: MATLAB script not found: $MATLAB_SCRIPT" >&2
  exit 1
fi

echo "[$(date)] Starting high-frequency generation on CPU via cpuq"
echo "Repository: $REPO_ROOT"
echo "Input: $HFF_BASE_DIR"
echo "MATLAB script: $MATLAB_SCRIPT"

"$MATLAB_BIN" \
  -licmode onlinelicensing \
  -batch "cd('$REPO_ROOT'); run('$MATLAB_SCRIPT')"

echo "[$(date)] High-frequency generation complete"